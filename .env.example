# AWS Oracle DB Backend REST API Base URL
# Local development uses the Vite /api proxy to https://api.01bo.cloud.
VITE_API_BASE_URL=/api
# .env.production sets https://api.01bo.cloud/api for production and APK builds.

# Google Maps API Key (Optional fallback for Location Service)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
