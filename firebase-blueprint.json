{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "employee"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "createdAt"]
    },
    "Trip": {
      "title": "Trip",
      "description": "A business trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "destination": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "purpose": { "type": "string" },
        "itinerary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "locationName": { "type": "string" },
              "address": { "type": "string" },
              "scheduledTime": { "type": "string" },
              "coords": {
                "type": "object",
                "properties": {
                  "lat": { "type": "number" },
                  "lng": { "type": "number" }
                },
                "required": ["lat", "lng"]
              }
            },
            "required": ["id", "locationName", "address", "scheduledTime", "coords"]
          }
        },
        "status": { "type": "string", "enum": ["active", "completed", "upcoming"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "destination", "startDate", "endDate", "purpose", "itinerary", "status", "createdAt"]
    },
    "CheckIn": {
      "title": "CheckIn",
      "description": "A check-in or check-out record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "userId": { "type": "string" },
        "itineraryItemId": { "type": "string" },
        "locationName": { "type": "string" },
        "coords": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          },
          "required": ["lat", "lng"]
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["check-in", "check-out"] },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "tripId", "userId", "itineraryItemId", "locationName", "coords", "timestamp", "type", "verified"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A business expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "merchant": { "type": "string" },
        "date": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tripId", "userId", "amount", "category", "merchant", "date", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and roles"
    },
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Business trips"
    },
    "/checkIns/{checkInId}": {
      "schema": { "$ref": "#/entities/CheckIn" },
      "description": "Check-in and check-out records"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Business expenses"
    }
  }
}
